[Unit]
Description=Nimku Proxy subscription bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mtproxyfinder
WorkingDirectory=/opt/mtproxy-finder-app/bot
EnvironmentFile=/opt/mtproxy-finder-app/bot/.env
ExecStart=/opt/mtproxy-finder-app/bot/.venv/bin/python bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
