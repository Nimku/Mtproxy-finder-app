# Copy this file to .env and fill in real values. Never commit the real .env.

# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-your-bot-token

# GitHub repo the license file lives in, and a fine-grained Personal Access Token
# with ONLY "Contents: Read and write" on this one repo. This token lives here,
# on your VPS, and is never shipped inside the Android app.
GITHUB_REPO=nimku/mtproxy-finder-app
GITHUB_BRANCH=main
GITHUB_TOKEN=github_pat_your_token_here

# MUST exactly match Constants.LICENSE_HASH_SALT in the Android app
# (app/src/main/java/com/nimku/mtproxyfinder/core/Constants.kt). Change both
# together before you launch, then never change it again (it would silently
# invalidate every existing subscriber's link).
HASH_SALT=mtpf-v1-change-this-salt

# Comma-separated Telegram numeric user IDs allowed to use /admin. Find your own
# ID by messaging @userinfobot.
ADMIN_IDS=123456789
