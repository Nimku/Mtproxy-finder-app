# ── Required ────────────────────────────────────────────────
# From @BotFather. Never commit the real value.
BOT_TOKEN=

# Your Telegram user ID — receives a summary after each rebuild.
# Leave empty to disable those reports.
ADMIN_ID=

# ── Telegram channel scraping (optional but recommended) ────
# Without these the bot scrapes only the HTTPS feeds and skips all 27 channels.
# Get API_ID/API_HASH from https://my.telegram.org → API development tools.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
# Must be unique per process on this machine. Two Telethon processes sharing
# one session file will corrupt it.
TG_SESSION=nimku_scraper_session

# ── Behaviour ───────────────────────────────────────────────
REFRESH_MINUTES=60
PROXIES_PER_CHANNEL=30
CHANNEL_MESSAGE_LIMIT=120

# How much filtering to do before publishing.
#
#   protocol  (default, recommended)
#             Drop only proxies that ANSWERED and then failed the MTProto
#             protocol — those aren't Telegram proxies at all (dead hosts now
#             serving a web server, wrong secrets), so they're dead everywhere.
#             Proxies we simply couldn't reach are KEPT: that may be this
#             server's route, and they can still work for the user.
#
#   strict    Publish only what passed from this server. Cleanest list, but
#             throws away proxies that are blocked from here and fine elsewhere.
#
#   off       Publish everything scraped, no network test at all. Biggest file,
#             mostly dead entries, all the work pushed onto the phone.
VERIFY_MODE=protocol
VERIFY_WORKERS=60
CONNECT_TIMEOUT_MS=2500
RESPONSE_TIMEOUT_MS=3500

# Cap on how many proxies go in the file, best (fastest) first.
MAX_PUBLISHED=2000

OUTPUT_DIR=data

# Optionally post each rebuilt list to a channel, e.g. @SetProxy.
# Leave empty to only hand the file out on request.
PUBLISH_CHANNEL=

# List every source and its count in the admin report. Off by default — that
# message is one forward or screenshot away from handing your whole source list
# to anyone. The counts are always written to the log regardless:
#     journalctl -u nimku-proxy-bot | grep -E 'feed |channel '
REPORT_SOURCES=false
